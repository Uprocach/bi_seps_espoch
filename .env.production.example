# =====================================================================
# VARIABLES DE ENTORNO DE PRODUCCIÓN - SISTEMA SFPS (ESPOCH DI-060)
# Copiar este archivo como '.env.production' en el servidor de despliegue
# =====================================================================

# Puerto público en el servidor anfitrión (ej. 80 para HTTP directo, o 3000 si usas Nginx externo)
APP_PORT=80

# Seguridad Criptográfica JWT
# Generar clave segura en Linux: openssl rand -hex 32
JWT_SECRET_KEY=cambiar_por_clave_segura_de_32_bytes_hexadecimales_minimo
JWT_EXPIRE_HOURS=24

# Credenciales de Acceso Institucional (Vista Acreditada Pro)
ACCREDITED_USER=investigador.espoch
ACCREDITED_PASSWORD=GenerarPasswordSeguroPro2026#

# Credenciales de Administración del Sistema
ADMIN_USER=admin.espoch
ADMIN_PASSWORD=GenerarPasswordSeguroAdmin2026#

# Rutas internas de contenedores (No modificar a menos que cambies los volúmenes)
DATA_MART_DIR=/app/data/processed/mart

# CORS: orígenes autorizados separados por coma
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
