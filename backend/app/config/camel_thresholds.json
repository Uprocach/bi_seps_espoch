      "messages": {
        "green": "Compromiso patrimonial por cartera en mora adecuado (≤ 20.0%).",
        "yellow": "Riesgo de absorción patrimonial moderado (20.0% - 35.0%).",
        "red": "Alerta crítica de insolvencia: Cartera vencida compromete más del 35.0% del patrimonio."
