{
  "version": "1.0.0",
  "updated_at": "2026-11-09",
  "source": "Superintendencia de Economía Popular y Solidaria (SEPS) y Junta de Política y Regulación Financiera (JPRF) / COMF",
  "default_rule": {
    "higher_is_better": {
      "warning_ratio": 0.85,
      "critical_ratio": 0.70
    },
    "lower_is_better": {
      "warning_ratio": 1.25,
      "critical_ratio": 1.50
    }
  },
  "indicators": {
    "solvencia_patrimonial": {
      "name": "Suficiencia Patrimonial",
      "dimension": "capital",
      "unit": "percent",
      "polarity": "higher_is_better",
      "normative_reference": "SEPS Ficha Metodológica 1",
      "thresholds": {
        "green_min": 100.0,
        "yellow_min": 80.0,
        "red_below": 80.0
      },
      "messages": {
        "green": "Patrimonio suficiente para cubrir activos inmovilizados netos (> 100%).",
        "yellow": "Alerta preventiva: Cobertura patrimonial de activos inmovilizados entre 80% y 100%.",
        "red": "Déficit patrimonial crítico: Cobertura inferior al 80% normativo SEPS."
      }
    },
    "seps_62_solvencia": {
      "name": "Suficiencia de Patrimonio Técnico (Solvencia)",
      "dimension": "capital",
      "unit": "percent",
      "polarity": "higher_is_better",
      "normative_reference": "COMF Art. 190 / Resolución SEPS (Mínimo Legal 9.0%)",
      "thresholds": {
        "green_min": 10.0,
        "yellow_min": 9.0,
        "red_below": 9.0
      },
      "messages": {
        "green": "Solvencia patrimonial holgada (≥ 10.0%), excede el requerimiento legal.",
        "yellow": "Alerta temprana: Margen prudencial estrecho (entre 9.0% y 10.0%).",
        "red": "Incumplimiento normativo severo: Patrimonio técnico menor al 9.0% regulatorio."
      }
    },
    "seps_2_proporcion_de_activos_improductiv": {
      "name": "Proporción de Activos Improductivos Netos",
      "dimension": "capital",
      "unit": "percent",
      "polarity": "lower_is_better",
      "normative_reference": "SEPS Ficha Metodológica 2",
      "thresholds": {
        "green_max": 5.0,
        "yellow_max": 8.0,
        "red_above": 8.0
      },
      "messages": {
        "green": "Carga de activos improductivos baja y controlada (≤ 5.0%).",
        "yellow": "Alerta de inmovilización: Activos improductivos entre 5.0% y 8.0%.",
        "red": "Inmovilización excesiva de balance: Activos improductivos superiores al 8.0%."
      }
    },
